# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys.
# These two values are SAFE to expose in the browser: the database
# security rules (Row Level Security) decide what each visitor can do.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---- AI "Suggest ingredients" (server-only: NO "VITE_" prefix, so it never reaches the browser) ----
# Get a key at console.anthropic.com -> API Keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Which provider + model. Change these to switch, no code change needed.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
# To use Kimi (or any OpenAI-style API) instead:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.moonshot.ai/v1
# AI_API_KEY=your-kimi-key
# AI_MODEL=a-kimi-model-that-accepts-images
